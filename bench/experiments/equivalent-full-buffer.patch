new file mode 100644
index 0000000..4912f35
--- /dev/null
+++ b/crates/psmc-cpu/src/lockstep.rs
@@ -0,0 +1,308 @@
+//! Four independent records in AVX lanes. No state or site reduction crosses lanes.
+//! All scalar structured parenthesization, divisions and scan directions survive.
+use crate::{PreparedModel, Workspace};
+use psmc_core::{
+    hmm::{Counts, Messages},
+    structured::StructuredModel,
+};
+
+#[derive(Default)]
+pub(crate) struct Lockstep {
+    forward: Vec<[f64; 4]>,
+    backward: Vec<[f64; 4]>,
+    scales: Vec<[f64; 4]>,
+    scratch: Vec<[f64; 4]>,
+}
+impl Lockstep {
+    pub(crate) fn evaluate(
+        &mut self,
+        workspace: &Workspace,
+        prepared: &PreparedModel<'_>,
+        records: [&[u8]; 4],
+        factors: &StructuredModel,
+    ) {
+        assert!(workspace.avx.is_some(), "lockstep needs detected AVX");
+        let n = prepared.model.n;
+        let len = records[0].len();
+        assert!(len > 0);
+        assert!(
+            records
+                .iter()
+                .all(|r| r.len() == len && r.iter().all(|&v| v <= 2))
+        );
+        let cells = len
+            .checked_add(1)
+            .and_then(|v| v.checked_mul(n))
+            .expect("messages too large");
+        for v in [&mut self.forward, &mut self.backward] {
+            if cells > v.capacity() {
+                v.reserve_exact(cells - v.len());
+            }
+            v.resize(cells, [0.; 4]);
+            v[..n].fill([0.; 4]);
+        }
+        if len + 1 > self.scales.capacity() {
+            self.scales.reserve_exact(len + 1 - self.scales.len());
+        }
+        self.scales.resize(len + 1, [0.; 4]);
+        self.scales[0] = [1.; 4];
+        self.scratch.resize(n, [0.; 4]);
+        #[cfg(target_arch = "x86_64")]
+        // SAFETY: runtime capability checked above. Equal nonempty record lengths,
+        // symbols 0..=2 and exact buffers are checked here. Model dimensions were
+        // checked by PreparedModel. Distinct mutable buffers cannot alias inputs.
+        unsafe {
+            self.avx_messages(prepared, records, factors);
+        }
+        #[cfg(not(target_arch = "x86_64"))]
+        unreachable!("AVX capability is never present on this architecture");
+    }
+    pub(crate) fn lane<'a>(
+        &self,
+        lane: usize,
+        workspace: &'a mut Workspace,
+        prepared: &PreparedModel<'_>,
+        obs: &[u8],
+    ) -> (&'a Messages, &'a Counts) {
+        assert!(lane < 4);
+        let n = prepared.model.n;
+        let cells = (obs.len() + 1) * n;
+        let m = &mut workspace.messages;
+        m.length = obs.len();
+        for (out, input) in [
+            (&mut m.forward, &self.forward),
+            (&mut m.backward, &self.backward),
+        ] {
+            crate::reserve_messages(out, cells);
+            out.resize(cells, 0.);
+            for (o, v) in out.iter_mut().zip(input) {
+                *o = v[lane];
+            }
+        }
+        crate::reserve_messages(&mut m.scales, obs.len() + 1);
+        m.scales.resize(obs.len() + 1, 0.);
+        for (o, v) in m.scales.iter_mut().zip(&self.scales) {
+            *o = v[lane];
+        }
+        workspace.finish_evaluation(prepared, obs, true)
+    }
+
+    #[cfg(target_arch = "x86_64")]
+    #[target_feature(enable = "avx")]
+    unsafe fn avx_messages(
+        &mut self,
+        prepared: &PreparedModel<'_>,
+        records: [&[u8]; 4],
+        factors: &StructuredModel,
+    ) {
+        use std::arch::x86_64::*;
+        let m = prepared.model;
+        let n = m.n;
+        let len = records[0].len();
+        let f = factors.message_factors();
+        assert_eq!(f.lower.len(), n);
+        assert_eq!(f.upper.len(), n);
+        assert_eq!(f.diagonal.len(), n);
+        assert_eq!(f.delta.len(), n);
+        assert_eq!(f.q_aux.len(), n - 1);
+        // SAFETY: each vector accesses exactly one checked [f64;4]. Every site,
+        // state and symbol index is bounded by the validated dimensions above.
+        unsafe {
+            let zero = _mm256_setzero_pd();
+            let one = _mm256_set1_pd(1.);
+            // Precompute the 3^4 possible emission vectors once for the model.
+            // This avoids four scalar gathers for every state at every site.
+            let mut emissions = vec![[0.; 4]; 81 * n];
+            for code in 0..81 {
+                let mut z = code;
+                let mut symbols = [0; 4];
+                for s in &mut symbols {
+                    *s = z % 3;
+                    z /= 3;
+                }
+                for k in 0..n {
+                    emissions[code * n + k] =
+                        std::array::from_fn(|l| m.emission[symbols[l] * n + k]);
+                }
+            }
+            let code = |u: usize| {
+                records[0][u] as usize
+                    + 3 * records[1][u] as usize
+                    + 9 * records[2][u] as usize
+                    + 27 * records[3][u] as usize
+            };
+            let mut sum = zero;
+            let e = &emissions[code(0) * n..];
+            for k in 0..n {
+                let v = _mm256_mul_pd(_mm256_set1_pd(m.initial[k]), _mm256_loadu_pd(e[k].as_ptr()));
+                _mm256_storeu_pd(self.forward[n + k].as_mut_ptr(), v);
+                sum = _mm256_add_pd(sum, v);
+            }
+            _mm256_storeu_pd(self.scales[1].as_mut_ptr(), sum);
+            for k in 0..n {
+                let v = _mm256_div_pd(_mm256_loadu_pd(self.forward[n + k].as_ptr()), sum);
+                _mm256_storeu_pd(self.forward[n + k].as_mut_ptr(), v);
+            }
+            for u in 2..=len {
+                let prev = (u - 1) * n;
+                let cur = u * n;
+                let mut suffix = zero;
+                for k in (0..n).rev() {
+                    _mm256_storeu_pd(self.scratch[k].as_mut_ptr(), suffix);
+                    suffix = _mm256_add_pd(
+                        suffix,
+                        _mm256_mul_pd(
+                            _mm256_loadu_pd(self.forward[prev + k].as_ptr()),
+                            _mm256_set1_pd(f.lower[k]),
+                        ),
+                    );
+                }
+                let mut prefix = zero;
+                sum = zero;
+                let e = &emissions[code(u - 1) * n..];
+                for k in 0..n {
+                    let prev = _mm256_loadu_pd(self.forward[prev + k].as_ptr());
+                    let lower = if k + 1 < n {
+                        _mm256_mul_pd(
+                            _mm256_set1_pd(f.q_aux[k]),
+                            _mm256_loadu_pd(self.scratch[k].as_ptr()),
+                        )
+                    } else {
+                        zero
+                    };
+                    let v = _mm256_mul_pd(
+                        _mm256_loadu_pd(e[k].as_ptr()),
+                        _mm256_add_pd(
+                            _mm256_add_pd(
+                                _mm256_mul_pd(_mm256_set1_pd(f.delta[k]), prefix),
+                                _mm256_mul_pd(prev, _mm256_set1_pd(f.diagonal[k])),
+                            ),
+                            lower,
+                        ),
+                    );
+                    _mm256_storeu_pd(self.forward[cur + k].as_mut_ptr(), v);
+                    sum = _mm256_add_pd(sum, v);
+                    prefix = _mm256_add_pd(prefix, _mm256_mul_pd(prev, _mm256_set1_pd(f.upper[k])));
+                }
+                _mm256_storeu_pd(self.scales[u].as_mut_ptr(), sum);
+                for k in 0..n {
+                    let v = _mm256_div_pd(_mm256_loadu_pd(self.forward[cur + k].as_ptr()), sum);
+                    _mm256_storeu_pd(self.forward[cur + k].as_mut_ptr(), v);
+                }
+            }
+            let last = _mm256_div_pd(one, _mm256_loadu_pd(self.scales[len].as_ptr()));
+            for k in 0..n {
+                _mm256_storeu_pd(self.backward[len * n + k].as_mut_ptr(), last);
+            }
+            for u in (1..len).rev() {
+                let cur = u * n;
+                let next = (u + 1) * n;
+                let e = &emissions[code(u) * n..];
+                let mut suffix = zero;
+                for k in (0..n).rev() {
+                    _mm256_storeu_pd(self.scratch[k].as_mut_ptr(), suffix);
+                    let x = _mm256_mul_pd(
+                        _mm256_loadu_pd(e[k].as_ptr()),
+                        _mm256_loadu_pd(self.backward[next + k].as_ptr()),
+                    );
+                    suffix = _mm256_add_pd(suffix, _mm256_mul_pd(_mm256_set1_pd(f.delta[k]), x));
+                }
+                let mut prefix = zero;
+                let scale = _mm256_loadu_pd(self.scales[u].as_ptr());
+                for k in 0..n {
+                    let x = _mm256_mul_pd(
+                        _mm256_loadu_pd(e[k].as_ptr()),
+                        _mm256_loadu_pd(self.backward[next + k].as_ptr()),
+                    );
+                    let v = _mm256_div_pd(
+                        _mm256_add_pd(
+                            _mm256_add_pd(
+                                _mm256_mul_pd(_mm256_set1_pd(f.lower[k]), prefix),
+                                _mm256_mul_pd(_mm256_set1_pd(f.diagonal[k]), x),
+                            ),
+                            _mm256_mul_pd(
+                                _mm256_set1_pd(f.upper[k]),
+                                _mm256_loadu_pd(self.scratch[k].as_ptr()),
+                            ),
+                        ),
+                        scale,
+                    );
+                    _mm256_storeu_pd(self.backward[cur + k].as_mut_ptr(), v);
+                    if k + 1 < n {
+                        prefix =
+                            _mm256_add_pd(prefix, _mm256_mul_pd(_mm256_set1_pd(f.q_aux[k]), x));
+                    }
+                }
+            }
+        }
+    }
+}
